# Copia este archivo como .env y cambia TODOS los valores. Nunca subas .env a GitHub.

# --- MySQL (Docker) ---  usa solo letras y números en las contraseñas
MYSQL_ROOT_PASSWORD=cambia_esta_root
MYSQL_USER=vyt_app
MYSQL_PASSWORD=cambia_esta_app

# --- API ---
# Genera una clave:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=pon_aqui_una_clave_larga_y_aleatoria
# Administrador inicial (se crea al arrancar si no existe; mínimo 8 caracteres)
ADMIN_EMAIL=admin@ejemplo.mx
ADMIN_PASSWORD=cambia_esta_contrasena
# Dominios del frontend autorizados (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Solo para ejecución local SIN Docker (XAMPP) ---
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/vuelo_y_tradicion
